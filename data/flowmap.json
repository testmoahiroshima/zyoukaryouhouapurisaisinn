     "id": "chojutsu11#120",
     "year": 1953,
     "date": "1953"
    }
   ]
  },
  {
   "from": "keibu_lymph",
   "to": "kao",
   "kind": "明言",
   "text": "頸の腺や肩に溜まった水膿が、顔面にまで移るとされる。",
   "cites": [
