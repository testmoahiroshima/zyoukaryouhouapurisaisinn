     "read": true
    }
   ]
  },
  {
   "from": "shinzou",
   "to": "hai",
   "kind": "明言",
   "text": "心臓の裏側の毒素が溶けて、痰となって肺に入ろうとするとされる。",
   "cites": [
    {
     "id": "chojutsu03#115",
     "year": 1942,
     "date": "194209",
     "read": true
    }
