{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "施術記録（1回分）",
 "type": "object",
 "required": [
  "session_id",
  "date",
  "receiver_code",
  "findings",
  "treatments"
 ],
 "properties": {
  "session_id": {
   "type": "string"
  },
  "date": {
   "type": "string",
   "format": "date"
  },
  "practitioner": {
   "type": "string",
   "description": "施術者（受講者）"
  },
  "receiver_code": {
   "type": "string",
   "description": "受け手の匿名コード。氏名は保存しない"
  },
  "complaints": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "受け手の訴え（flows.json の stage を選択＋自由記述）"
  },
  "self_rating_before": {
   "type": "object",
   "description": "受け手の自己評価 0-10（つらさ）",
   "additionalProperties": {
    "type": "integer",
    "minimum": 0,
    "maximum": 10
   }
  },
  "findings": {
   "type": "array",
   "description": "探査結果",
   "items": {
    "type": "object",
    "required": [
     "point_id"
    ],
    "properties": {
     "point_id": {
      "type": "string",
      "description": "body_points.json の id"
     },
     "heat": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "塗りの濃さから読み取った値（0〜5）"
     },
     "kouketsu": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "塗りの濃さから読み取った値（0〜5）"
     },
     "atsutsuu": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "塗りの濃さから読み取った値（0〜5）"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "treatments": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "point_id",
     "minutes"
    ],
    "properties": {
     "point_id": {
      "type": "string"
     },
     "minutes": {
      "type": "number"
     },
     "order": {
      "type": "integer"
     }
    }
   }
  },
  "findings_after": {
   "type": "array",
   "description": "施術後の再探査（findings と同じ形式）",
   "items": {
    "type": "object",
    "required": [
     "point_id"
    ],
    "properties": {
     "point_id": {
      "type": "string",
      "description": "body_points.json の id"
     },
     "heat": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "塗りの濃さから読み取った値（0〜5）"
     },
     "kouketsu": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "塗りの濃さから読み取った値（0〜5）"
     },
     "atsutsuu": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "塗りの濃さから読み取った値（0〜5）"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "self_rating_after": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 0,
    "maximum": 10
   }
  },
  "changes_observed": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "changes.json の id または自由記述"
  },
  "follow_up": {
   "type": "string",
   "description": "翌日以降の変化（排泄・平均浄化・再浄化など）"
  },
  "memo": {
   "type": "string",
   "description": "施術時のメモ（氏名は書かない）"
  },
  "plan_minutes": {
   "type": "object",
   "description": "探査・確認にかけた分",
   "properties": {
    "probe": {
     "type": "number"
    },
    "check": {
     "type": "number"
    }
   }
  },
  "places": {
   "type": "array",
   "description": "つらい場所。図でさした所は細かい名前（左右・上中下・前後）と座標（m、yが上・zが前・+xが体の左）",
   "items": {
    "type": "object",
    "properties": {
     "zone": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "side": {
      "type": [
       "string",
       "null"
      ],
      "enum": [
       "L",
       "R",
       null
      ]
     },
     "at": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
     }
    },
    "required": [
     "zone",
     "label"
    ]
   }
  },
  "next_advice": {
   "type": "array",
   "description": "施術の前後の探査から出した、次回の施術のあり方の提案（engine.js の nextAdvice）",
   "items": {
    "type": "object",
    "properties": {
     "kind": {
      "type": "string"
     },
     "text": {
      "type": "string"
     }
    }
   }
  },
  "previous_session": {
   "type": "string",
   "description": "続きとして始めた前回の記録の session_id（同じ受け手）"
  }
 }
}
